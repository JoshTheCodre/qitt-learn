# Copy to .env.local and fill in real values (.env.local is gitignored)

# Full PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Individual connection parts
PGHOST=HOST
PGPORT=5432
PGUSER=USER
PGPASSWORD=PASSWORD
PGDATABASE=DATABASE

# Cloudflare R2 (server-side only — never NEXT_PUBLIC_*)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Password for the /admin upload dashboard
ADMIN_PASSWORD=

# Secret used to sign the auth session cookie (any long random string).
# Falls back to a dev default if unset — set a real value before production.
SESSION_SECRET=

# OpenRouter — grades open-ended (theory) practice answers, server-side only.
# https://openrouter.ai/keys — without a key, theory practice self-marks instead.
# The grader tries a built-in lineup of free models (best first) and falls through on
# failure. OPENROUTER_MODEL pins one model to the front; OPENROUTER_MODELS (comma-
# separated) replaces the whole lineup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free
